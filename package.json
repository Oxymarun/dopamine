{
  "name": "dopamine",
  "version": "2.0.0.0",
  "description": "ADHD Focus Widget for macOS",
  "main": "main.js",
  "author": "Arun Sharma",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:app": "concurrently -k -n VITE,ELECTRON -c cyan,yellow \"vite\" \"wait-on http://localhost:5173 && ELECTRON_DEV=1 electron .\"",
    "build:renderer": "vite build",
    "start": "electron .",
    "start:dev": "ELECTRON_DEV=1 electron .",
    "build": "npm run build:renderer && electron-builder --mac",
    "build:dmg": "npm run build:renderer && electron-builder --mac dmg"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^8.0.9",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.arunsharma.dopamine",
    "productName": "Dopamine",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "Dopamine",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**"
    ]
  },
  "dependencies": {
    "@radix-ui/react-tabs": "^1.1.13",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
